# 版本控制忽略规则（仓库根 = Identification_of_gene_family_members/）
#
# 说明：本项目含大体积参考数据（Zunla 蛋白组 21 MB、Araport11 8.5 MB），
#      不建议纳入 git，另行传输；临时文件目录同理。

# ---- 大体积参考数据（另行传输，不入库）----
01_At_TRM_query/Zunla_Canz.pep.fa
01_At_TRM_query/Araport11_pep_20250411.gz

# ---- BLAST 运行产物（在服务器生成，体积与机器相关）----
*.blast.tsv
*.pdb
*.phr
*.pin
*.psq
*.pot
*.ptf
*.pto
*.pjs
Canz.pep.*

# ---- 临时文件目录 ----
04_temp/

# ---- HMMER 流程运行产物（体积大、可重跑，不入库；脚本与文档保留）----
06_hmmer_results/01_env_check/*
06_hmmer_results/02_msa/*
06_hmmer_results/03_hmmbuild/*
06_hmmer_results/04_hmmsearch/*
06_hmmer_results/05_merge/*
06_hmmer_results/06_domain/*
06_hmmer_results/07_final/*
# 各阶段目录本身保留（.gitkeep），只忽略其中的文件
!06_hmmer_results/**/.gitkeep

# ---- HMMER 相关大文件 ----
*.hmm
*.h3f
*.h3i
*.h3m
*.h3p
*.domtblout
*.tblout
Pfam-A.*

# ---- Python ----
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ---- 系统与办公软件 ----
~$*
Thumbs.db
desktop.ini
.DS_Store

# ---- Claude Code 本地设置 ----
.claude/settings.local.json
